#############################################
# 🧪 CYPRESS E2E TEST CONFIGURATION
#
# Copy this file to .env.test.local (gitignored) before running
#   npm run test:e2e        (headless)
#   npm run test:e2e:ui     (interactive)
#
# This file is read by BOTH the Next.js server started for the tests and the
# Cypress config (cypress.config.ts), so the server and the specs always agree
# on the database and on the rental rules.
#############################################

# 🗄️ Test database. MUST be exactly this path: cypress.config.ts seeds
# prisma/database/automated-test-db.db. The file is created by
# `npm run test:e2e:prepare` (runs automatically before test:e2e; it deletes
# and recreates the file with `prisma db push` every time).
# Never point this at your real database - every spec truncates all tables.
DATABASE_URL="file:./prisma/database/automated-test-db.db"

# Marks this server as a test server: enables /api/test/dbinfo, which
# cypress.config.ts uses to verify that the server reads the seeded database.
# Never set this on a real installation.
E2E_TEST_MODE=true

# Specs log in, so authentication must be on.
AUTH_ENABLED=true
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=cypress-test-secret-not-for-production

# The specs assert German UI texts.
OPENLIBRY_LOCALE=de
NEXT_PUBLIC_OPENLIBRY_LOCALE=de

# Rental rules. The specs compute expected due dates from these values.
RENTAL_DURATION_DAYS=21
EXTENSION_DURATION_DAYS=14
MAX_EXTENSIONS=2

# Keep tests fast and deterministic.
DELETE_SAFETY_SECONDS=0
SECURITY_HEADERS=insecure
LOGIN_SESSION_TIMEOUT=3600
BARCODE_MINCODELENGTH=3
NUMBER_BOOKS_OVERVIEW=20
NUMBER_BOOKS_MAX=10000
RENTAL_SORT_BOOKS="title_asc"

# Cover images uploaded by specs land here. Use a throwaway folder.
COVERIMAGE_FILESTORAGE_PATH=./prisma/database/test-images

# Optional: leave empty so specs never hit the Google Books API quota.
GOOGLE_BOOKS_API_KEY=
